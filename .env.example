# ============================================================
# AI Scientist — Environment Configuration
# Copy this file to `.env.local` and fill in your keys.
# ============================================================

# -- LLM provider (OpenAI-compatible) ------------------------
# Works with OpenAI, OpenRouter, Together, Groq, Anthropic via
# proxy, Cursor's gateway, or any OpenAI-compatible endpoint.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini

# -- Tavily (literature + web search) ------------------------
# Get a key at https://tavily.com
TAVILY_API_KEY=tvly-...

# -- Semantic Scholar (optional, public, no key required) ----
# An API key raises rate limits. Leave blank to use the public
# endpoint.
SEMANTIC_SCHOLAR_API_KEY=

# -- Feedback / persistence ----------------------------------
# Where to store edited plans + scientist feedback. Defaults
# to a local JSON file. In production, swap for Vercel KV /
# Postgres (see src/lib/store.ts).
FEEDBACK_STORE_PATH=./data/feedback.local.json
